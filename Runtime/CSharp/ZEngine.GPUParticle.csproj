<Project Sdk="Microsoft.NET.Sdk">

  <!-- 与 C++ 侧 ParticleGpuFormat.h / Curves / Emitter / Batch 配套：同一份语义，
       两种语言各实现一遍。netstandard2.1 ⇒ Unity（C# 9 / netstandard2.1）可以
       把整个目录源码拷进 Assets，不需要 NuGet 包，也不依赖 Unity API —— 这样才
       能在本地用 dotnet 跑跨语言对拍。

       为什么要做镜像：OSGame 的效果是美术在 Unity ParticleSystem 里出的，Unity
       侧必须能用**同一套**曲线语义、同一个随机器、同一份发射调度复现出与 ZEngine
       逐位相同的粒子，否则"同一个特效在两端看起来不一样"只能靠肉眼抓。 -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ZEngine.GPUParticle</AssemblyName>
    <RootNamespace>ZEngine.GPUParticle</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Test/ 有自己的 csproj，别被这个工程一起编进来 -->
  <ItemGroup>
    <Compile Remove="Test/**/*.cs" />
  </ItemGroup>

</Project>
